{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-guide.local/schemas/dicom-guide-clinician-visit-packet-v1.schema.json",
  "title": "DICOM Guide unreviewed clinician visit packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "review_status",
    "artifact_type",
    "pairing",
    "observations",
    "computed_results",
    "candidate_interpretations",
    "limitations",
    "missing_context",
    "questions_for_clinician",
    "implementation",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "review_status": { "const": "unreviewed" },
    "artifact_type": { "const": "clinician_visit_packet" },
    "pairing": { "$ref": "#/$defs/pairing" },
    "observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/baselineObservation" },
        { "$ref": "#/$defs/followupObservation" }
      ]
    },
    "computed_results": { "type": "array", "maxItems": 0 },
    "candidate_interpretations": { "type": "array", "maxItems": 0 },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" },
    "missing_context": { "$ref": "#/$defs/nonEmptyStrings" },
    "questions_for_clinician": { "$ref": "#/$defs/nonEmptyStrings" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "DICOM Guide clinician visit-packet assembler" },
        "version": { "const": "0.1.0" }
      }
    },
    "files": { "$ref": "#/$defs/files" }
  },
  "$defs": {
    "seriesId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|series_[0-9a-f]{20})$"
    },
    "studyId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|study_[0-9a-f]{20})$"
    },
    "patientContextId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|patient_[0-9a-f]{20})$"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|instance_[0-9a-f]{20})$"
    },
    "frameId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|frame_[0-9a-f]{20})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "modality",
        "baseline_acquisition_date",
        "followup_acquisition_date",
        "elapsed_days",
        "same_patient_context",
        "distinct_source_studies",
        "distinct_source_series",
        "registration_status",
        "image_relationship"
      ],
      "properties": {
        "method": { "const": "explicit_key_image_selection" },
        "modality": { "enum": ["MR", "CT"] },
        "baseline_acquisition_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "followup_acquisition_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "elapsed_days": { "type": "integer", "minimum": 1 },
        "same_patient_context": { "const": true },
        "distinct_source_studies": { "const": true },
        "distinct_source_series": { "const": true },
        "registration_status": { "const": "not_registered" },
        "image_relationship": { "const": "side_by_side_only" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "series_id",
        "instance_id",
        "patient_context_id",
        "modality",
        "acquisition_date",
        "series_description",
        "instance_number"
      ],
      "properties": {
        "study_id": { "$ref": "#/$defs/studyId" },
        "series_id": { "$ref": "#/$defs/seriesId" },
        "instance_id": { "$ref": "#/$defs/instanceId" },
        "patient_context_id": { "$ref": "#/$defs/patientContextId" },
        "frame_of_reference_id": { "$ref": "#/$defs/frameId" },
        "modality": { "enum": ["MR", "CT"] },
        "acquisition_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "series_description": { "type": "string", "minLength": 1 },
        "instance_number": { "type": "integer" }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "top", "bottom"],
      "properties": {
        "left": { "type": "string", "pattern": "^[RLAPHF]{1,3}$" },
        "right": { "type": "string", "pattern": "^[RLAPHF]{1,3}$" },
        "top": { "type": "string", "pattern": "^[RLAPHF]{1,3}$" },
        "bottom": { "type": "string", "pattern": "^[RLAPHF]{1,3}$" }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voi_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "upper"],
          "properties": {
            "lower": { "type": "number" },
            "upper": { "type": "number" }
          }
        },
        "invert": { "type": "boolean" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 },
        "pan": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewport_role",
        "stack_position",
        "stack_count",
        "source_kind",
        "viewport_width_px",
        "viewport_height_px",
        "presentation"
      ],
      "properties": {
        "viewport_role": { "enum": ["baseline", "followup"] },
        "stack_position": { "type": "integer", "minimum": 1 },
        "stack_count": { "type": "integer", "minimum": 1 },
        "source_kind": { "enum": ["browser-folder", "loopback-service"] },
        "viewport_width_px": { "type": "integer", "minimum": 1 },
        "viewport_height_px": { "type": "integer", "minimum": 1 },
        "patient_orientation": { "$ref": "#/$defs/orientation" },
        "presentation": { "$ref": "#/$defs/presentation" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timepoint",
        "source",
        "display",
        "key_image_path",
        "key_image_sidecar_path",
        "measurement_path",
        "measurement_count",
        "tracking_ids",
        "review_status"
      ],
      "properties": {
        "timepoint": { "enum": ["baseline", "followup"] },
        "source": { "$ref": "#/$defs/source" },
        "display": { "$ref": "#/$defs/display" },
        "key_image_path": { "type": "string" },
        "key_image_sidecar_path": { "type": "string" },
        "measurement_path": { "type": "string" },
        "measurement_count": { "type": "integer", "minimum": 0 },
        "tracking_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "review_status": { "const": "unreviewed" }
      }
    },
    "baselineObservation": {
      "allOf": [
        { "$ref": "#/$defs/observation" },
        {
          "properties": {
            "timepoint": { "const": "baseline" },
            "display": {
              "allOf": [
                { "$ref": "#/$defs/display" },
                { "properties": { "viewport_role": { "const": "baseline" } } }
              ]
            },
            "key_image_path": { "const": "baseline/key-image.png" },
            "key_image_sidecar_path": { "const": "baseline/key-image.json" },
            "measurement_path": { "const": "baseline/measurements.json" }
          }
        }
      ]
    },
    "followupObservation": {
      "allOf": [
        { "$ref": "#/$defs/observation" },
        {
          "properties": {
            "timepoint": { "const": "followup" },
            "display": {
              "allOf": [
                { "$ref": "#/$defs/display" },
                { "properties": { "viewport_role": { "const": "followup" } } }
              ]
            },
            "key_image_path": { "const": "followup/key-image.png" },
            "key_image_sidecar_path": { "const": "followup/key-image.json" },
            "measurement_path": { "const": "followup/measurements.json" }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "byte_count", "sha256"],
      "properties": {
        "media_type": { "type": "string", "minLength": 1 },
        "byte_count": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review.html",
        "README.txt",
        "baseline/key-image.json",
        "baseline/key-image.png",
        "baseline/measurements.json",
        "followup/key-image.json",
        "followup/key-image.png",
        "followup/measurements.json"
      ],
      "properties": {
        "review.html": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "properties": { "media_type": { "const": "text/html" } } }
          ]
        },
        "README.txt": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "properties": { "media_type": { "const": "text/plain" } } }
          ]
        },
        "baseline/key-image.json": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "properties": { "media_type": { "const": "application/json" } } }
          ]
        },
        "baseline/key-image.png": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "properties": { "media_type": { "const": "image/png" } } }
          ]
        },
        "baseline/measurements.json": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "properties": { "media_type": { "const": "application/json" } } }
          ]
        },
        "followup/key-image.json": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "properties": { "media_type": { "const": "application/json" } } }
          ]
        },
        "followup/key-image.png": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "properties": { "media_type": { "const": "image/png" } } }
          ]
        },
        "followup/measurements.json": {
          "allOf": [
            { "$ref": "#/$defs/file" },
            { "properties": { "media_type": { "const": "application/json" } } }
          ]
        }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
