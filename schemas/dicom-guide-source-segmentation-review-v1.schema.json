{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-guide.local/schemas/dicom-guide-source-segmentation-review-v1.schema.json",
  "title": "DICOM Guide source DICOM SEG boundary review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "review_id",
    "created_at",
    "review_status",
    "local_only",
    "sensitive",
    "deidentified",
    "privacy",
    "source_snapshot",
    "reviewer",
    "review",
    "attestation",
    "permitted_uses",
    "limitations",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "dicom-guide.source-segmentation-review" },
    "review_id": {
      "type": "string",
      "pattern": "^source_seg_review_[0-9a-f-]{36}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "review_status": {
      "enum": ["accepted_for_discussion", "revision_requested", "rejected"]
    },
    "local_only": { "const": true },
    "sensitive": { "const": true },
    "deidentified": { "const": false },
    "privacy": {
      "const": {
        "classification": "sensitive_local_medical_data",
        "contains_original_dicom": true,
        "contains_source_text": true,
        "contains_segmentation_mask_pixels": true,
        "may_contain_direct_identifiers": true,
        "deidentified": false
      }
    },
    "source_snapshot": { "$ref": "#/$defs/sourceSnapshot" },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "review": { "$ref": "#/$defs/review" },
    "attestation": {
      "const": "I attest that I personally reviewed the complete source-carried DICOM SEG boundary on the original local source images within the scope of my stated role. I treated the source label, codes, creator, and algorithm as unauthenticated and unverified. DICOM Guide has not verified my identity or credentials."
    },
    "permitted_uses": { "$ref": "#/$defs/permittedUses" },
    "limitations": {
      "const": [
        "Reviewer identity, role, and credentials are self-asserted and are not authenticated by DICOM Guide.",
        "Acceptance means suitable for discussion only; it is not clinical validation, medical-record sign-off, or regulatory clearance.",
        "The boundary originates in a source-carried DICOM SEG object; DICOM Guide does not authenticate its creator or verify its algorithm, label, codes, accuracy, or clinical meaning.",
        "The exact source SEG object and reconstructed native-grid mask are embedded, but boundary uncertainty remains unquantified.",
        "This review applies to one exact source series and does not establish that another scan contains the same lesion or represented tissue.",
        "Differences in acquisition, motion, partial-volume effects, enhancement, edema, necrosis, treatment effect, and boundary choices can alter a mask or volume.",
        "No longitudinal link, volume change, percentage change, treatment-response category, diagnosis, or clinical conclusion is authorized.",
        "Original DICOM images, the original DICOM SEG object, and the clinical medical record remain authoritative."
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_segmentation", "mask", "review_page", "readme"],
      "properties": {
        "source_segmentation": {
          "$ref": "#/$defs/file",
          "properties": { "filename": { "const": "source-segmentation.dcm" } }
        },
        "mask": {
          "$ref": "#/$defs/file",
          "properties": { "filename": { "const": "mask.bin" } }
        },
        "review_page": {
          "$ref": "#/$defs/file",
          "properties": { "filename": { "const": "review.html" } }
        },
        "readme": {
          "$ref": "#/$defs/file",
          "properties": { "filename": { "const": "README.txt" } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "review_status": { "const": "accepted_for_discussion" } } },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "decision": { "const": "accepted_for_discussion" },
              "acquisition_suitability": { "const": "suitable" },
              "checklist": {
                "properties": {
                  "original_images_reviewed": { "const": true },
                  "full_source_boundary_reviewed": { "const": true },
                  "all_three_planes_reviewed": { "const": true },
                  "mask_to_source_alignment_reviewed": { "const": true },
                  "source_segment_metadata_treated_as_unverified": { "const": true },
                  "creator_and_algorithm_treated_as_unverified": { "const": true },
                  "motion_considered": { "const": true },
                  "partial_volume_considered": { "const": true },
                  "treatment_effect_considered": { "const": true },
                  "acquisition_protocol_considered": { "const": true }
                }
              }
            }
          },
          "source_snapshot": {
            "properties": { "patient_context_id": { "$ref": "#/$defs/patientId" } }
          },
          "permitted_uses": {
            "properties": {
              "reviewed_volume_for_discussion": { "const": true },
              "eligible_for_future_pairing_review": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "review_status": { "const": "revision_requested" } } },
      "then": {
        "properties": {
          "review": { "properties": { "decision": { "const": "revision_requested" } } },
          "permitted_uses": {
            "properties": {
              "reviewed_volume_for_discussion": { "const": false },
              "eligible_for_future_pairing_review": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "review_status": { "const": "rejected" } } },
      "then": {
        "properties": {
          "review": { "properties": { "decision": { "const": "rejected" } } },
          "permitted_uses": {
            "properties": {
              "reviewed_volume_for_discussion": { "const": false },
              "eligible_for_future_pairing_review": { "const": false }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "opaqueId": {
      "type": "string",
      "pattern": "^(?:study|series|instance|frame|patient)_[0-9a-f]{20}$"
    },
    "patientId": {
      "type": "string",
      "pattern": "^patient_[0-9a-f]{20}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "bytes", "sha256"],
      "properties": {
        "filename": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 440401920 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_segmentation_catalog_sha256",
        "segmentation_id",
        "segment_number",
        "source_segmentation_study_id",
        "source_segmentation_series_id",
        "source_segmentation_instance_id",
        "source_segmentation_bytes",
        "source_segmentation_sha256",
        "source_segment_metadata_sha256",
        "patient_context_id",
        "study_id",
        "series_id",
        "frame_of_reference_id",
        "modality",
        "source_set_sha256",
        "mask_pixel_sha256",
        "foreground_voxel_count",
        "volume_mm3",
        "volume_ml",
        "boundary_uncertainty",
        "geometry_relationship",
        "source_creator_identity_authenticated",
        "source_algorithm_verified",
        "source_segment_accuracy_verified",
        "source_segment_clinical_meaning",
        "dicom_guide_interpretation_added"
      ],
      "properties": {
        "source_kind": { "const": "source_carried_dicom_seg" },
        "source_segmentation_catalog_sha256": { "$ref": "#/$defs/sha256" },
        "segmentation_id": {
          "type": "string",
          "pattern": "^instance_[0-9a-f]{20}$"
        },
        "segment_number": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "source_segmentation_study_id": { "$ref": "#/$defs/opaqueId" },
        "source_segmentation_series_id": { "$ref": "#/$defs/opaqueId" },
        "source_segmentation_instance_id": {
          "type": "string",
          "pattern": "^instance_[0-9a-f]{20}$"
        },
        "source_segmentation_bytes": {
          "type": "integer",
          "minimum": 132,
          "maximum": 268435456
        },
        "source_segmentation_sha256": { "$ref": "#/$defs/sha256" },
        "source_segment_metadata_sha256": { "$ref": "#/$defs/sha256" },
        "patient_context_id": {
          "oneOf": [{ "$ref": "#/$defs/patientId" }, { "type": "null" }]
        },
        "study_id": { "$ref": "#/$defs/opaqueId" },
        "series_id": { "$ref": "#/$defs/opaqueId" },
        "frame_of_reference_id": { "$ref": "#/$defs/opaqueId" },
        "modality": { "enum": ["MR", "CT"] },
        "source_set_sha256": { "$ref": "#/$defs/sha256" },
        "mask_pixel_sha256": { "$ref": "#/$defs/sha256" },
        "foreground_voxel_count": { "type": "integer", "minimum": 1 },
        "volume_mm3": { "type": "number", "exclusiveMinimum": 0 },
        "volume_ml": { "type": "number", "exclusiveMinimum": 0 },
        "boundary_uncertainty": { "const": "not_quantified" },
        "geometry_relationship": { "const": "exact_native_source_grid" },
        "source_creator_identity_authenticated": { "const": false },
        "source_algorithm_verified": { "const": false },
        "source_segment_accuracy_verified": { "const": false },
        "source_segment_clinical_meaning": { "const": "not_assessed" },
        "dicom_guide_interpretation_added": { "const": false }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "organization", "identity_verification"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": {
          "enum": [
            "radiologist",
            "neuro_oncologist",
            "neurosurgeon",
            "medical_physicist",
            "other_qualified_clinician"
          ]
        },
        "organization": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 160 },
            { "type": "null" }
          ]
        },
        "identity_verification": { "const": "self_asserted_unverified" }
      }
    },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_images_reviewed",
        "full_source_boundary_reviewed",
        "all_three_planes_reviewed",
        "mask_to_source_alignment_reviewed",
        "source_segment_metadata_treated_as_unverified",
        "creator_and_algorithm_treated_as_unverified",
        "motion_considered",
        "partial_volume_considered",
        "treatment_effect_considered",
        "acquisition_protocol_considered"
      ],
      "properties": {
        "original_images_reviewed": { "type": "boolean" },
        "full_source_boundary_reviewed": { "type": "boolean" },
        "all_three_planes_reviewed": { "type": "boolean" },
        "mask_to_source_alignment_reviewed": { "type": "boolean" },
        "source_segment_metadata_treated_as_unverified": { "type": "boolean" },
        "creator_and_algorithm_treated_as_unverified": { "type": "boolean" },
        "motion_considered": { "type": "boolean" },
        "partial_volume_considered": { "type": "boolean" },
        "treatment_effect_considered": { "type": "boolean" },
        "acquisition_protocol_considered": { "type": "boolean" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "acquisition_suitability",
        "planes_reviewed",
        "represented_tissue",
        "inclusion_criteria",
        "exclusion_criteria",
        "note",
        "checklist"
      ],
      "properties": {
        "decision": {
          "enum": ["accepted_for_discussion", "revision_requested", "rejected"]
        },
        "acquisition_suitability": {
          "enum": ["suitable", "uncertain", "not_suitable"]
        },
        "planes_reviewed": { "const": ["axial", "coronal", "sagittal"] },
        "represented_tissue": { "type": "string", "minLength": 1, "maxLength": 500 },
        "inclusion_criteria": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "exclusion_criteria": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "note": { "type": "string", "maxLength": 2000 },
        "checklist": { "$ref": "#/$defs/checklist" }
      }
    },
    "permittedUses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_boundary_discussion",
        "reviewed_volume_for_discussion",
        "eligible_for_future_pairing_review",
        "source_segmentation_edit",
        "source_label_as_clinical_finding",
        "source_creator_authenticated",
        "longitudinal_link",
        "percent_change",
        "response_classification",
        "diagnosis",
        "clinical_conclusion"
      ],
      "properties": {
        "source_boundary_discussion": { "const": true },
        "reviewed_volume_for_discussion": { "type": "boolean" },
        "eligible_for_future_pairing_review": { "type": "boolean" },
        "source_segmentation_edit": { "const": false },
        "source_label_as_clinical_finding": { "const": false },
        "source_creator_authenticated": { "const": false },
        "longitudinal_link": { "const": false },
        "percent_change": { "const": false },
        "response_classification": { "const": false },
        "diagnosis": { "const": false },
        "clinical_conclusion": { "const": false }
      }
    }
  }
}
