{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-guide.local/schemas/dicom-guide-native-boundary-display-v1.schema.json",
  "title": "DICOM Guide reviewed native-boundary comparison display context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "local_only",
    "sensitive",
    "deidentified",
    "display_status",
    "display_label",
    "comparison_id",
    "review",
    "comparison",
    "timepoints",
    "navigation_policy",
    "display_policy",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": {
      "const": "lesion_volume_native_boundary_display_context"
    },
    "local_only": { "const": true },
    "sensitive": { "const": true },
    "deidentified": { "const": false },
    "display_status": {
      "const": "authorized_reviewed_native_boundaries_unregistered"
    },
    "display_label": {
      "const": "REVIEWED NATIVE BOUNDARIES — UNREGISTERED"
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^volume_pair_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewer_role",
        "identity_status",
        "same_lesion_identity",
        "same_represented_tissue",
        "acquisition_comparability",
        "boundary_comparability",
        "registration_consideration",
        "limitation_note",
        "treatment_context_note"
      ],
      "properties": {
        "decision": { "const": "accepted_for_volume_change_discussion" },
        "reviewer_role": {
          "enum": [
            "radiologist",
            "neuro_oncologist",
            "neurosurgeon",
            "medical_physicist",
            "other_qualified_clinician"
          ]
        },
        "identity_status": { "const": "self_attested_unverified" },
        "same_lesion_identity": { "const": "confirmed" },
        "same_represented_tissue": { "const": "confirmed" },
        "acquisition_comparability": {
          "enum": ["suitable", "suitable_with_limitations"]
        },
        "boundary_comparability": {
          "enum": ["suitable", "suitable_with_limitations"]
        },
        "registration_consideration": {
          "enum": [
            "not_required",
            "recommended_before_spatial_comparison",
            "required_before_spatial_comparison"
          ]
        },
        "limitation_note": { "$ref": "#/$defs/optionalLongText" },
        "treatment_context_note": { "$ref": "#/$defs/optionalLongText" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "baseline_volume_ml",
        "followup_volume_ml",
        "absolute_change_ml",
        "percent_change",
        "numeric_direction",
        "elapsed_days",
        "boundary_uncertainty",
        "response_assessment",
        "causal_treatment_attribution",
        "interpretations"
      ],
      "properties": {
        "status": {
          "const": "qualified_pairing_review_for_discussion_only"
        },
        "method": {
          "const": "followup_reviewed_volume_minus_baseline_reviewed_volume"
        },
        "baseline_volume_ml": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "followup_volume_ml": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "absolute_change_ml": { "type": "number" },
        "percent_change": { "type": "number" },
        "numeric_direction": {
          "enum": ["increased", "decreased", "unchanged"]
        },
        "elapsed_days": { "type": "integer", "minimum": 1 },
        "boundary_uncertainty": { "const": "not_quantified" },
        "response_assessment": { "const": "not_performed" },
        "causal_treatment_attribution": { "const": false },
        "interpretations": { "const": [] }
      }
    },
    "timepoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "followup"],
      "properties": {
        "baseline": {
          "allOf": [
            { "$ref": "#/$defs/timepoint" },
            {
              "properties": {
                "role": { "const": "baseline" },
                "mask": {
                  "properties": {
                    "url": {
                      "const": "/v1/lesion-volume-comparison-display/masks/baseline"
                    }
                  }
                }
              }
            }
          ]
        },
        "followup": {
          "allOf": [
            { "$ref": "#/$defs/timepoint" },
            {
              "properties": {
                "role": { "const": "followup" },
                "mask": {
                  "properties": {
                    "url": {
                      "const": "/v1/lesion-volume-comparison-display/masks/followup"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "navigation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_linked",
        "link_mode",
        "approximate_navigation_only",
        "anatomical_correspondence",
        "registered",
        "independent_navigation_available"
      ],
      "properties": {
        "default_linked": { "const": false },
        "link_mode": { "const": "normalized_native_grid_fraction" },
        "approximate_navigation_only": { "const": true },
        "anatomical_correspondence": { "const": false },
        "registered": { "const": false },
        "independent_navigation_available": { "const": true }
      }
    },
    "display_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_modes",
        "always_locked",
        "masks_read_only",
        "native_dicom_required"
      ],
      "properties": {
        "allowed_modes": {
          "const": [
            "native_side_by_side",
            "normalized_navigation_link"
          ]
        },
        "always_locked": {
          "const": [
            "spatial_overlay",
            "voxelwise_change_localization",
            "subtraction",
            "mask_propagation",
            "response_classification",
            "causal_treatment_attribution",
            "diagnosis",
            "clinical_conclusion",
            "medical_record_signoff"
          ]
        },
        "masks_read_only": { "const": true },
        "native_dicom_required": { "const": true }
      }
    },
    "limitations": {
      "const": [
        "Each accepted boundary is displayed only on its own exact native DICOM grid.",
        "The two native coordinate systems are not registered and must never be overlaid, subtracted, or treated as spatially corresponding.",
        "Optional normalized navigation mirrors fractional grid location only; it is approximate navigation, not anatomical alignment.",
        "Reviewer identity, role, and credentials are self asserted and unauthenticated.",
        "The displayed regions are manually painted boundaries whose uncertainty is not quantified.",
        "The pairing reviewer attested same-lesion and represented-tissue judgments for discussion only.",
        "Volume arithmetic can be affected by acquisition, enhancement, edema, necrosis, treatment effect, motion, and partial-volume differences.",
        "No voxelwise change, biological tumor burden, progression, treatment response, treatment causality, diagnosis, or clinical conclusion is established.",
        "Original DICOM images, radiology reports, pathology, treatment history, and the clinical medical record remain authoritative."
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^(patient|study|series|frame|instance)_[0-9a-f]{20}$"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^review_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^seg_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "optionalLongText": {
      "type": "string",
      "maxLength": 2000
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "bytes",
        "sha256",
        "scalar_type",
        "binary_values",
        "grid_order"
      ],
      "properties": {
        "url": { "type": "string" },
        "bytes": {
          "type": "integer",
          "minimum": 8,
          "maximum": 67108864
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "scalar_type": { "const": "uint8" },
        "binary_values": { "const": [0, 1] },
        "grid_order": { "const": "source_volume_frame_row_column" }
      }
    },
    "boundaryReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "self_attested",
        "represented_tissue",
        "inclusion_criteria",
        "exclusion_criteria",
        "boundary_uncertainty"
      ],
      "properties": {
        "status": { "const": "accepted_for_discussion" },
        "self_attested": { "const": true },
        "represented_tissue": { "$ref": "#/$defs/shortText" },
        "inclusion_criteria": { "$ref": "#/$defs/longText" },
        "exclusion_criteria": { "$ref": "#/$defs/longText" },
        "boundary_uncertainty": { "const": "not_quantified" }
      }
    },
    "timepoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "review_id",
        "evidence_artifact_id",
        "patient_context_id",
        "study_id",
        "series_id",
        "frame_of_reference_id",
        "modality",
        "acquisition_date",
        "series_description",
        "protocol_name",
        "source_set_sha256",
        "ordered_instance_ids",
        "dimensions",
        "reviewed_volume_ml",
        "foreground_voxel_count",
        "mask",
        "boundary_review"
      ],
      "properties": {
        "role": { "enum": ["baseline", "followup"] },
        "review_id": { "$ref": "#/$defs/reviewId" },
        "evidence_artifact_id": { "$ref": "#/$defs/evidenceId" },
        "patient_context_id": {
          "allOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "pattern": "^patient_" }
          ]
        },
        "study_id": {
          "allOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "pattern": "^study_" }
          ]
        },
        "series_id": {
          "allOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "pattern": "^series_" }
          ]
        },
        "frame_of_reference_id": {
          "allOf": [
            { "$ref": "#/$defs/opaqueId" },
            { "pattern": "^frame_" }
          ]
        },
        "modality": { "enum": ["MR", "CT"] },
        "acquisition_date": { "$ref": "#/$defs/date" },
        "series_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "protocol_name": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 300 }
          ]
        },
        "source_set_sha256": { "$ref": "#/$defs/sha256" },
        "ordered_instance_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 67108864,
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/opaqueId" },
              { "pattern": "^instance_" }
            ]
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "type": "integer", "minimum": 2, "maximum": 67108864 },
            { "type": "integer", "minimum": 2, "maximum": 67108864 },
            { "type": "integer", "minimum": 3, "maximum": 67108864 }
          ],
          "items": false
        },
        "reviewed_volume_ml": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "foreground_voxel_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "mask": { "$ref": "#/$defs/mask" },
        "boundary_review": { "$ref": "#/$defs/boundaryReview" }
      }
    }
  }
}
