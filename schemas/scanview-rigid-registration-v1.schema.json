{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanview.local/schemas/scanview-rigid-registration-v1.schema.json",
  "title": "ScanView rigid registration pending QA v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_state",
    "review_status",
    "sensitive",
    "deidentified",
    "created_at",
    "job_id",
    "source",
    "pairing",
    "algorithm",
    "files",
    "qa",
    "computed_results",
    "candidate_interpretations",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "rigid_registration" },
    "artifact_state": { "const": "generated_pending_qa" },
    "review_status": { "const": "unreviewed" },
    "sensitive": { "const": true },
    "deidentified": { "const": false },
    "created_at": { "type": "string", "format": "date-time" },
    "job_id": {
      "type": "string",
      "pattern": "^registration_[0-9a-f]{20}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "fixed", "moving", "transform_direction"],
      "properties": {
        "immutable": { "const": true },
        "fixed": { "$ref": "#/$defs/fixedSource" },
        "moving": { "$ref": "#/$defs/movingSource" },
        "transform_direction": {
          "const": "moving_later_to_fixed_earlier"
        }
      }
    },
    "pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "same_patient_context",
        "patient_identity_status",
        "same_modality",
        "distinct_studies",
        "strictly_chronological",
        "brain_or_head_anatomy",
        "diagnostic_original_primary",
        "regular_volume_geometry",
        "sequence_family",
        "contrast_category",
        "clinical_baseline_status",
        "metadata_compatibility",
        "same_lesion_identity"
      ],
      "properties": {
        "selection": { "const": "human_attested_unverified" },
        "same_patient_context": { "const": true },
        "patient_identity_status": { "const": "opaque_context_match_unverified" },
        "same_modality": { "const": true },
        "distinct_studies": { "const": true },
        "strictly_chronological": { "const": true },
        "brain_or_head_anatomy": { "const": true },
        "diagnostic_original_primary": { "const": true },
        "regular_volume_geometry": { "const": true },
        "sequence_family": { "enum": ["ct", "t1", "t2", "flair", "dwi", "adc", "swi"] },
        "contrast_category": { "enum": ["contrast", "noncontrast"] },
        "clinical_baseline_status": { "const": "not_assessed" },
        "metadata_compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "compatibility",
            "warnings",
            "auto_approved",
            "review_status",
            "sequence_family",
            "contrast_category"
          ],
          "properties": {
            "score": { "type": "integer", "minimum": 80, "maximum": 100 },
            "compatibility": { "const": "compatible" },
            "warnings": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 80 },
              "uniqueItems": true
            },
            "auto_approved": { "const": false },
            "review_status": { "const": "unreviewed" },
            "sequence_family": { "enum": ["ct", "t1", "t2", "flair", "dwi", "adc", "swi"] },
            "contrast_category": { "enum": ["contrast", "noncontrast"] }
          }
        },
        "same_lesion_identity": { "const": "not_assessed" }
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "application_version",
        "repository_revision",
        "module",
        "platform",
        "parameters",
        "transform_coordinate_system",
        "executable_sha256",
        "runner_sha256",
        "engine_identity",
        "external_api_requested_by_scanview",
        "network_isolation"
      ],
      "properties": {
        "engine": { "const": "3D Slicer" },
        "application_version": { "const": "5.12.3" },
        "repository_revision": { "const": "9034c71" },
        "module": { "const": "BRAINSFit" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 80 },
        "parameters": { "$ref": "#/$defs/parameters" },
        "transform_coordinate_system": { "const": "DICOM patient LPS" },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runner_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "engine_identity": {
          "const": "self_reported_version_revision_expected_binary_hash_matched_distributor_not_authenticated"
        },
        "external_api_requested_by_scanview": { "const": false },
        "network_isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "mechanism",
            "external_network",
            "host_network",
            "unsandboxed_fallback"
          ],
          "properties": {
            "status": { "const": "os_enforced" },
            "mechanism": {
              "enum": [
                "macos_sandbox_exec_deny_all_network",
                "linux_bwrap_network_namespace_seccomp_no_sockets"
              ]
            },
            "external_network": { "const": "denied" },
            "host_network": { "const": "isolated" },
            "unsandboxed_fallback": { "const": false }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/file" },
      "allOf": [
        { "contains": { "properties": { "name": { "const": "engine-report.json" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "fixed.nrrd" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "moving-to-fixed.tfm" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "moving.nrrd" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "registered-moving.nrrd" } }, "required": ["name"] } }
      ]
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_at",
        "review_record",
        "required_checks",
        "display_unlocks"
      ],
      "properties": {
        "status": { "const": "pending" },
        "reviewed_at": { "type": "null" },
        "review_record": { "type": "null" },
        "required_checks": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 180 },
          "uniqueItems": true
        },
        "display_unlocks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overlay", "swipe", "subtraction", "mask_propagation"],
          "properties": {
            "overlay": { "const": false },
            "swipe": { "const": false },
            "subtraction": { "const": false },
            "mask_propagation": { "const": false }
          }
        }
      }
    },
    "computed_results": { "type": "array", "maxItems": 0 },
    "candidate_interpretations": { "type": "array", "maxItems": 0 },
    "limitations": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 220 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "bytes", "sha256"],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^instance_[0-9a-f]{20}$"
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "patient_context_id",
        "study_id",
        "series_id",
        "acquisition_date",
        "modality",
        "instance_count",
        "instances_sha256",
        "instances"
      ],
      "properties": {
        "role": { "type": "string" },
        "patient_context_id": {
          "type": "string",
          "pattern": "^patient_[0-9a-f]{20}$"
        },
        "study_id": {
          "type": "string",
          "pattern": "^study_[0-9a-f]{20}$"
        },
        "series_id": {
          "type": "string",
          "pattern": "^series_[0-9a-f]{20}$"
        },
        "acquisition_date": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "modality": { "enum": ["MR", "CT"] },
        "instance_count": { "type": "integer", "minimum": 5 },
        "instances_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instances": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/instance" }
        }
      }
    },
    "fixedSource": {
      "allOf": [
        { "$ref": "#/$defs/sourceBase" },
        { "properties": { "role": { "const": "fixed_earlier" } } }
      ]
    },
    "movingSource": {
      "allOf": [
        { "$ref": "#/$defs/sourceBase" },
        { "properties": { "role": { "const": "moving_later" } } }
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transform_type",
        "degrees_of_freedom",
        "initialize_transform_mode",
        "mask_processing_mode",
        "roi_auto_dilate_mm",
        "sampling_percentage",
        "interpolation_mode",
        "histogram_match"
      ],
      "properties": {
        "transform_type": { "const": "Rigid" },
        "degrees_of_freedom": { "const": 6 },
        "initialize_transform_mode": { "const": "useCenterOfHeadAlign" },
        "mask_processing_mode": { "const": "ROIAUTO" },
        "roi_auto_dilate_mm": { "const": 3.0 },
        "sampling_percentage": { "const": 0.02 },
        "interpolation_mode": { "const": "Linear" },
        "histogram_match": { "const": false }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": {
          "enum": [
            "engine-report.json",
            "fixed.nrrd",
            "moving-to-fixed.tfm",
            "moving.nrrd",
            "registered-moving.nrrd"
          ]
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
