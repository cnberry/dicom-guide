{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-guide.local/schemas/dicom-guide-measurements-v3.schema.json",
  "title": "DICOM Guide measurement evidence packet v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "review_status", "measurements", "limitations"],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "review_status": { "const": "unreviewed" },
    "measurements": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/lengthMeasurement" },
          { "$ref": "#/$defs/bidirectionalMeasurement" },
          { "$ref": "#/$defs/ellipticalRoiMeasurement" }
        ]
      }
    },
    "limitations": { "$ref": "#/$defs/limitations" }
  },
  "$defs": {
    "seriesId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|series_[0-9a-f]{20})$"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|instance_[0-9a-f]{20})$"
    },
    "frameId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|frame_[0-9a-f]{20})$"
    },
    "point3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_id", "instance_id"],
      "properties": {
        "series_id": { "$ref": "#/$defs/seriesId" },
        "instance_id": { "$ref": "#/$defs/instanceId" },
        "frame_of_reference_id": { "$ref": "#/$defs/frameId" }
      }
    },
    "lengthGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_system", "world_points"],
      "properties": {
        "coordinate_system": { "const": "DICOM patient LPS" },
        "world_points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/point3" }
        }
      }
    },
    "fourPointGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_system", "world_points"],
      "properties": {
        "coordinate_system": { "const": "DICOM patient LPS" },
        "world_points": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/point3" }
        }
      }
    },
    "measurementBase": {
      "type": "object",
      "required": [
        "tracking_id",
        "type",
        "review_status",
        "source",
        "geometry",
        "result",
        "method",
        "limitations"
      ],
      "properties": {
        "tracking_id": { "type": "string", "minLength": 1 },
        "review_status": { "const": "unreviewed" },
        "source": { "$ref": "#/$defs/source" },
        "limitations": { "$ref": "#/$defs/limitations" }
      }
    },
    "lengthMeasurement": {
      "allOf": [
        { "$ref": "#/$defs/measurementBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tracking_id": true,
            "type": { "const": "length" },
            "review_status": true,
            "source": true,
            "geometry": { "$ref": "#/$defs/lengthGeometry" },
            "result": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "unit"],
                  "properties": {
                    "value": { "type": "number", "minimum": 0 },
                    "unit": { "const": "mm" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["unit"],
                  "properties": { "unit": { "const": "unknown" } }
                }
              ]
            },
            "method": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "implementation"],
              "properties": {
                "name": { "const": "manual_two_point_length" },
                "implementation": { "const": "Cornerstone3D LengthTool" }
              }
            },
            "limitations": true
          }
        }
      ]
    },
    "bidirectionalMeasurement": {
      "allOf": [
        { "$ref": "#/$defs/measurementBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tracking_id": true,
            "type": { "const": "bidirectional" },
            "review_status": true,
            "source": true,
            "geometry": { "$ref": "#/$defs/fourPointGeometry" },
            "result": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["long_axis", "short_axis", "product", "unit", "product_unit"],
                  "properties": {
                    "long_axis": { "type": "number", "minimum": 0 },
                    "short_axis": { "type": "number", "minimum": 0 },
                    "product": { "type": "number", "minimum": 0 },
                    "unit": { "const": "mm" },
                    "product_unit": { "const": "mm2" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["unit", "product_unit"],
                  "properties": {
                    "unit": { "const": "unknown" },
                    "product_unit": { "const": "unknown" }
                  }
                }
              ]
            },
            "method": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "implementation"],
              "properties": {
                "name": { "const": "manual_perpendicular_bidirectional" },
                "implementation": { "const": "Cornerstone3D BidirectionalTool" }
              }
            },
            "limitations": true
          }
        }
      ]
    },
    "ellipticalRoiMeasurement": {
      "allOf": [
        { "$ref": "#/$defs/measurementBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tracking_id": true,
            "type": { "const": "elliptical_roi" },
            "review_status": true,
            "source": true,
            "geometry": { "$ref": "#/$defs/fourPointGeometry" },
            "result": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["major_axis", "minor_axis", "area", "unit", "area_unit"],
                  "properties": {
                    "major_axis": { "type": "number", "minimum": 0 },
                    "minor_axis": { "type": "number", "minimum": 0 },
                    "area": { "type": "number", "minimum": 0 },
                    "unit": { "const": "mm" },
                    "area_unit": { "const": "mm2" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["unit", "area_unit"],
                  "properties": {
                    "unit": { "const": "unknown" },
                    "area_unit": { "const": "unknown" }
                  }
                }
              ]
            },
            "method": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "implementation"],
              "properties": {
                "name": { "const": "manual_elliptical_roi" },
                "implementation": { "const": "Cornerstone3D EllipticalROITool" }
              }
            },
            "limitations": true
          }
        }
      ]
    }
  }
}
