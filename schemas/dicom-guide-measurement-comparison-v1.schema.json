{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-guide.local/schemas/dicom-guide-measurement-comparison-v1.schema.json",
  "title": "DICOM Guide unreviewed measurement comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "review_status",
    "pairing",
    "observations",
    "computed_results",
    "candidate_interpretations",
    "limitations",
    "missing_context",
    "questions_for_clinician"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "review_status": { "const": "unreviewed" },
    "pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "baseline_measurement_id",
        "followup_measurement_id"
      ],
      "properties": {
        "method": { "const": "explicit_tracking_id_selection" },
        "lesion_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?!.*[\\u0000-\\u001F\\u007F]).*$"
        },
        "baseline_measurement_id": { "type": "string", "minLength": 1 },
        "followup_measurement_id": { "type": "string", "minLength": 1 }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/baselineObservation" },
        { "$ref": "#/$defs/followupObservation" }
      ]
    },
    "computed_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/computedResult" }
    },
    "candidate_interpretations": {
      "type": "array",
      "maxItems": 0,
      "description": "Deliberately empty until a qualified review workflow exists."
    },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" },
    "missing_context": { "$ref": "#/$defs/nonEmptyStrings" },
    "questions_for_clinician": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "seriesId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|series_[0-9a-f]{20})$"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|instance_[0-9a-f]{20})$"
    },
    "frameId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|frame_[0-9a-f]{20})$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_id", "instance_id"],
      "properties": {
        "series_id": { "$ref": "#/$defs/seriesId" },
        "instance_id": { "$ref": "#/$defs/instanceId" },
        "frame_of_reference_id": { "$ref": "#/$defs/frameId" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timepoint", "measurement_type", "source", "review_status"],
      "properties": {
        "timepoint": { "enum": ["baseline", "followup"] },
        "measurement_type": { "enum": ["length", "bidirectional", "elliptical_roi"] },
        "source": { "$ref": "#/$defs/source" },
        "review_status": { "const": "unreviewed" }
      }
    },
    "baselineObservation": {
      "allOf": [
        { "$ref": "#/$defs/observation" },
        { "properties": { "timepoint": { "const": "baseline" } } }
      ]
    },
    "followupObservation": {
      "allOf": [
        { "$ref": "#/$defs/observation" },
        { "properties": { "timepoint": { "const": "followup" } } }
      ]
    },
    "computedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "baseline",
        "followup",
        "absolute_change",
        "unit",
        "source_measurement_ids",
        "review_status"
      ],
      "properties": {
        "metric": {
          "enum": [
            "length",
            "long_axis",
            "short_axis",
            "bidimensional_product",
            "major_axis",
            "minor_axis",
            "elliptical_area"
          ]
        },
        "baseline": { "type": "number", "minimum": 0 },
        "followup": { "type": "number", "minimum": 0 },
        "absolute_change": { "type": "number" },
        "percent_change": { "type": "number" },
        "unit": { "enum": ["mm", "mm2"] },
        "source_measurement_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "review_status": { "const": "unreviewed" }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
