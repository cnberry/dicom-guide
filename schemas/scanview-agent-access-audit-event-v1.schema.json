{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanview.local/schemas/scanview-agent-access-audit-event-v1.schema.json",
  "title": "ScanView privacy-minimized agent access audit event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "sequence",
    "occurred_at",
    "authority",
    "operation",
    "outcome",
    "local_only",
    "contains_patient_content",
    "contains_token",
    "contains_path",
    "contains_request_target",
    "previous_event_sha256",
    "event_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "scanview.agent-access-audit-event" },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "authority": { "const": "bearer_agent" },
    "operation": {
      "enum": [
        "manifest_read",
        "viewer_state_read",
        "comparison_candidates_read",
        "native_boundary_summary_read",
        "registration_status_read",
        "native_dicom_instance_read",
        "browser_only_native_boundary_context_attempt",
        "browser_only_native_boundary_mask_attempt",
        "browser_only_registration_context_attempt",
        "browser_only_registration_volume_attempt"
      ]
    },
    "outcome": { "const": "bearer_authorized_request" },
    "local_only": { "const": true },
    "contains_patient_content": { "const": false },
    "contains_token": { "const": false },
    "contains_path": { "const": false },
    "contains_request_target": { "const": false },
    "previous_event_sha256": { "$ref": "#/$defs/sha256" },
    "event_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
