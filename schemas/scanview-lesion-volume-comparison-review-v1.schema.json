{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanview.local/schemas/scanview-lesion-volume-comparison-review-v1.schema.json",
  "title": "ScanView reviewed manual ROI volume comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "comparison_id",
    "created_at",
    "state",
    "local_only",
    "sensitive",
    "deidentified",
    "timepoints",
    "pairing_review",
    "comparison",
    "attestation",
    "permitted_uses",
    "limitations",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "scanview.lesion-volume-comparison-review" },
    "comparison_id": {
      "type": "string",
      "pattern": "^volume_pair_[0-9a-f-]{36}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "state": {
      "enum": [
        "qualified_pairing_review_for_discussion",
        "pairing_revision_or_rejection_record"
      ]
    },
    "local_only": { "const": true },
    "sensitive": { "const": true },
    "deidentified": { "const": false },
    "timepoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "followup"],
      "properties": {
        "baseline": { "$ref": "#/$defs/timepoint" },
        "followup": { "$ref": "#/$defs/timepoint" }
      }
    },
    "pairing_review": { "$ref": "#/$defs/pairingReview" },
    "comparison": {
      "oneOf": [{ "$ref": "#/$defs/comparison" }, { "type": "null" }]
    },
    "attestation": {
      "const": "I attest that I personally reviewed both accepted boundary records and their original local source images, and recorded my judgments about chronology, same-lesion identity, represented tissue, acquisition comparability, boundary comparability, and registration need. ScanView has not verified my identity or credentials."
    },
    "permitted_uses": { "$ref": "#/$defs/permittedUses" },
    "limitations": {
      "const": [
        "Reviewer identity, role, and credentials are self-asserted and are not authenticated by ScanView.",
        "Both inputs are separately reviewed manual native-grid boundaries; their boundary uncertainty remains unquantified.",
        "Same-lesion and same-represented-tissue judgments are person-attested and are not established by software.",
        "Absolute and percentage volume change are geometry arithmetic for discussion, not biological tumor burden or a response category.",
        "Acquisition, motion, partial-volume effects, enhancement, edema, necrosis, treatment effect, and boundary choices can change the values.",
        "A treatment-context note does not establish that treatment caused any observed numeric difference.",
        "This artifact does not perform or authorize spatial registration, overlay, subtraction, or voxelwise change localization.",
        "Original DICOM images and the clinical medical record remain authoritative."
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_review",
        "followup_review",
        "review_page",
        "readme"
      ],
      "properties": {
        "baseline_review": {
          "$ref": "#/$defs/file",
          "properties": { "filename": { "const": "baseline-review.zip" } }
        },
        "followup_review": {
          "$ref": "#/$defs/file",
          "properties": { "filename": { "const": "followup-review.zip" } }
        },
        "review_page": {
          "$ref": "#/$defs/file",
          "properties": { "filename": { "const": "review.html" } }
        },
        "readme": {
          "$ref": "#/$defs/file",
          "properties": { "filename": { "const": "README.txt" } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pairing_review": {
            "properties": {
              "decision": { "const": "accepted_for_volume_change_discussion" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "state": { "const": "qualified_pairing_review_for_discussion" },
          "pairing_review": {
            "properties": {
              "same_lesion_identity": { "const": "confirmed" },
              "same_represented_tissue": { "const": "confirmed" },
              "chronology": { "const": "confirmed" },
              "acquisition_comparability": {
                "enum": ["suitable", "suitable_with_limitations"]
              },
              "boundary_comparability": {
                "enum": ["suitable", "suitable_with_limitations"]
              },
              "checklist": {
                "properties": {
                  "both_original_sources_reviewed": { "const": true },
                  "both_complete_boundaries_reviewed": { "const": true },
                  "boundary_definitions_compared": { "const": true },
                  "same_lesion_identity_reviewed": { "const": true },
                  "same_represented_tissue_reviewed": { "const": true },
                  "acquisition_differences_reviewed": { "const": true },
                  "chronology_confirmed": { "const": true },
                  "registration_need_reviewed": { "const": true }
                }
              }
            }
          },
          "comparison": { "$ref": "#/$defs/comparison" },
          "permitted_uses": {
            "properties": {
              "same_lesion_pair_for_discussion": { "const": true },
              "absolute_volume_change_for_discussion": { "const": true },
              "percent_volume_change_for_discussion": { "const": true }
            }
          }
        }
      },
      "else": {
        "properties": {
          "state": { "const": "pairing_revision_or_rejection_record" },
          "comparison": { "type": "null" },
          "permitted_uses": {
            "properties": {
              "same_lesion_pair_for_discussion": { "const": false },
              "absolute_volume_change_for_discussion": { "const": false },
              "percent_volume_change_for_discussion": { "const": false }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "opaqueId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|(?:study|series|instance|frame|patient)_[0-9a-f]{20})$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "bytes", "sha256"],
      "properties": {
        "filename": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 356515840 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "timepoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "evidence_artifact_id",
        "patient_context_id",
        "study_id",
        "series_id",
        "frame_of_reference_id",
        "modality",
        "acquisition_date",
        "series_description",
        "protocol_name",
        "source_set_sha256",
        "mask_pixel_sha256",
        "foreground_voxel_count",
        "reviewed_volume_ml",
        "boundary_uncertainty",
        "represented_tissue",
        "inclusion_criteria",
        "exclusion_criteria"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^review_[0-9a-f-]{36}$"
        },
        "evidence_artifact_id": {
          "type": "string",
          "pattern": "^seg_[0-9a-f-]{36}$"
        },
        "patient_context_id": { "$ref": "#/$defs/opaqueId" },
        "study_id": { "$ref": "#/$defs/opaqueId" },
        "series_id": { "$ref": "#/$defs/opaqueId" },
        "frame_of_reference_id": { "$ref": "#/$defs/opaqueId" },
        "modality": { "enum": ["MR", "CT"] },
        "acquisition_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "series_description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "protocol_name": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 300 },
            { "type": "null" }
          ]
        },
        "source_set_sha256": { "$ref": "#/$defs/sha256" },
        "mask_pixel_sha256": { "$ref": "#/$defs/sha256" },
        "foreground_voxel_count": { "type": "integer", "minimum": 1 },
        "reviewed_volume_ml": { "type": "number", "exclusiveMinimum": 0 },
        "boundary_uncertainty": { "const": "not_quantified" },
        "represented_tissue": { "type": "string", "minLength": 1, "maxLength": 500 },
        "inclusion_criteria": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "exclusion_criteria": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "organization", "identity_verification"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": {
          "enum": [
            "radiologist",
            "neuro_oncologist",
            "neurosurgeon",
            "medical_physicist",
            "other_qualified_clinician"
          ]
        },
        "organization": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 160 },
            { "type": "null" }
          ]
        },
        "identity_verification": { "const": "self_asserted_unverified" }
      }
    },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "both_original_sources_reviewed",
        "both_complete_boundaries_reviewed",
        "boundary_definitions_compared",
        "same_lesion_identity_reviewed",
        "same_represented_tissue_reviewed",
        "acquisition_differences_reviewed",
        "chronology_confirmed",
        "registration_need_reviewed"
      ],
      "properties": {
        "both_original_sources_reviewed": { "type": "boolean" },
        "both_complete_boundaries_reviewed": { "type": "boolean" },
        "boundary_definitions_compared": { "type": "boolean" },
        "same_lesion_identity_reviewed": { "type": "boolean" },
        "same_represented_tissue_reviewed": { "type": "boolean" },
        "acquisition_differences_reviewed": { "type": "boolean" },
        "chronology_confirmed": { "type": "boolean" },
        "registration_need_reviewed": { "type": "boolean" }
      }
    },
    "pairingReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "decision",
        "same_lesion_identity",
        "same_represented_tissue",
        "chronology",
        "acquisition_comparability",
        "boundary_comparability",
        "registration_consideration",
        "limitation_note",
        "treatment_context_note",
        "checklist",
        "identity_verification"
      ],
      "properties": {
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "decision": {
          "enum": [
            "accepted_for_volume_change_discussion",
            "revision_requested",
            "rejected"
          ]
        },
        "same_lesion_identity": {
          "enum": ["confirmed", "uncertain", "not_confirmed"]
        },
        "same_represented_tissue": {
          "enum": ["confirmed", "uncertain", "not_confirmed"]
        },
        "chronology": { "enum": ["confirmed", "not_confirmed"] },
        "acquisition_comparability": {
          "enum": ["suitable", "suitable_with_limitations", "not_suitable"]
        },
        "boundary_comparability": {
          "enum": ["suitable", "suitable_with_limitations", "not_suitable"]
        },
        "registration_consideration": {
          "enum": ["required", "not_required", "uncertain"]
        },
        "limitation_note": { "type": "string", "maxLength": 2000 },
        "treatment_context_note": { "type": "string", "maxLength": 2000 },
        "checklist": { "$ref": "#/$defs/checklist" },
        "identity_verification": { "const": "self_asserted_unverified" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "baseline_volume_ml",
        "followup_volume_ml",
        "absolute_change_ml",
        "percent_change",
        "numeric_direction",
        "elapsed_days",
        "boundary_uncertainty",
        "response_assessment",
        "causal_treatment_attribution",
        "interpretations"
      ],
      "properties": {
        "status": { "const": "qualified_pairing_review_for_discussion_only" },
        "method": {
          "const": "followup_reviewed_volume_minus_baseline_reviewed_volume"
        },
        "baseline_volume_ml": { "type": "number", "exclusiveMinimum": 0 },
        "followup_volume_ml": { "type": "number", "exclusiveMinimum": 0 },
        "absolute_change_ml": { "type": "number" },
        "percent_change": { "type": "number" },
        "numeric_direction": { "enum": ["increased", "decreased", "unchanged"] },
        "elapsed_days": { "type": "integer", "minimum": 1 },
        "boundary_uncertainty": { "const": "not_quantified" },
        "response_assessment": { "const": "not_performed" },
        "causal_treatment_attribution": { "const": false },
        "interpretations": { "const": [] }
      }
    },
    "permittedUses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_single_timepoint_volumes_for_discussion",
        "same_lesion_pair_for_discussion",
        "absolute_volume_change_for_discussion",
        "percent_volume_change_for_discussion",
        "spatial_overlay",
        "voxelwise_change_localization",
        "causal_treatment_attribution",
        "response_classification",
        "diagnosis",
        "clinical_conclusion",
        "medical_record_signoff"
      ],
      "properties": {
        "reviewed_single_timepoint_volumes_for_discussion": { "const": true },
        "same_lesion_pair_for_discussion": { "type": "boolean" },
        "absolute_volume_change_for_discussion": { "type": "boolean" },
        "percent_volume_change_for_discussion": { "type": "boolean" },
        "spatial_overlay": { "const": false },
        "voxelwise_change_localization": { "const": false },
        "causal_treatment_attribution": { "const": false },
        "response_classification": { "const": false },
        "diagnosis": { "const": false },
        "clinical_conclusion": { "const": false },
        "medical_record_signoff": { "const": false }
      }
    }
  }
}
