{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanview.local/schemas/scanview-manifest-v1.schema.json",
  "title": "ScanView local DICOM manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "privacy", "source", "studies", "agent_contract"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "privacy": {
      "type": "object",
      "required": ["classification", "direct_identifier_tags_excluded", "deidentified", "warning"],
      "properties": {
        "classification": { "const": "sensitive_local_medical_data" },
        "direct_identifier_tags_excluded": { "type": "boolean" },
        "deidentified": { "const": false },
        "warning": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["root_label", "immutable", "dicom_instances", "skipped_non_image_files"],
      "properties": {
        "root_label": { "type": "string" },
        "immutable": { "const": true },
        "dicom_instances": { "type": "integer", "minimum": 0 },
        "skipped_non_image_files": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "studies": {
      "type": "array",
      "items": { "$ref": "#/$defs/study" }
    },
    "agent_contract": {
      "type": "object",
      "required": [
        "review_status",
        "observations",
        "computed_results",
        "candidate_interpretations",
        "limitations",
        "missing_context",
        "questions_for_clinician"
      ],
      "properties": {
        "review_status": { "enum": ["unreviewed", "accepted", "rejected"] },
        "observations": { "type": "array" },
        "computed_results": { "type": "array" },
        "candidate_interpretations": { "type": "array" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "missing_context": { "type": "array", "items": { "type": "string" } },
        "questions_for_clinician": { "type": "array" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "study": {
      "type": "object",
      "required": ["id", "series", "review_status"],
      "properties": {
        "id": { "type": "string", "pattern": "^study_[a-f0-9]{20}$" },
        "acquisition_date": { "type": ["string", "null"] },
        "review_status": { "const": "unreviewed" },
        "series": {
          "type": "array",
          "items": { "$ref": "#/$defs/series" }
        }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": ["id", "modality", "series_description", "instance_count", "instances", "review_status"],
      "properties": {
        "id": { "type": "string", "pattern": "^series_[a-f0-9]{20}$" },
        "modality": { "type": "string" },
        "series_description": { "type": "string" },
        "instance_count": { "type": "integer", "minimum": 1 },
        "instances": { "type": "array" },
        "review_status": { "const": "unreviewed" }
      },
      "additionalProperties": true
    }
  }
}
