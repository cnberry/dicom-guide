{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-guide.local/schemas/dicom-guide-key-image-v1.schema.json",
  "title": "DICOM Guide derived display key-image evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "review_status",
    "artifact_type",
    "source",
    "display",
    "image",
    "measurement_evidence",
    "implementation",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "review_status": { "const": "unreviewed" },
    "artifact_type": { "const": "derived_display_key_image" },
    "source": { "$ref": "#/$defs/source" },
    "display": { "$ref": "#/$defs/display" },
    "image": { "$ref": "#/$defs/image" },
    "measurement_evidence": { "$ref": "#/$defs/measurementEvidence" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "limitations": { "$ref": "#/$defs/limitations" }
  },
  "$defs": {
    "seriesId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|series_[0-9a-f]{20})$"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|instance_[0-9a-f]{20})$"
    },
    "frameId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16}|frame_[0-9a-f]{20})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "instance_id",
        "modality",
        "series_description",
        "instance_number"
      ],
      "properties": {
        "series_id": { "$ref": "#/$defs/seriesId" },
        "instance_id": { "$ref": "#/$defs/instanceId" },
        "frame_of_reference_id": { "$ref": "#/$defs/frameId" },
        "modality": { "type": "string", "minLength": 1 },
        "acquisition_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "series_description": { "type": "string", "minLength": 1 },
        "instance_number": { "type": "integer" }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "top", "bottom"],
      "properties": {
        "left": { "type": "string", "pattern": "^[RLAPHF]{1,3}$" },
        "right": { "type": "string", "pattern": "^[RLAPHF]{1,3}$" },
        "top": { "type": "string", "pattern": "^[RLAPHF]{1,3}$" },
        "bottom": { "type": "string", "pattern": "^[RLAPHF]{1,3}$" }
      }
    },
    "voiRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "number" },
        "upper": { "type": "number" }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voi_range": { "$ref": "#/$defs/voiRange" },
        "invert": { "type": "boolean" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 },
        "pan": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewport_role",
        "stack_position",
        "stack_count",
        "source_kind",
        "viewport_width_px",
        "viewport_height_px",
        "presentation"
      ],
      "properties": {
        "viewport_role": { "enum": ["baseline", "followup"] },
        "stack_position": { "type": "integer", "minimum": 1 },
        "stack_count": { "type": "integer", "minimum": 1 },
        "source_kind": { "enum": ["browser-folder", "loopback-service"] },
        "viewport_width_px": { "type": "integer", "minimum": 1 },
        "viewport_height_px": { "type": "integer", "minimum": 1 },
        "patient_orientation": { "$ref": "#/$defs/orientation" },
        "presentation": { "$ref": "#/$defs/presentation" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "mime_type", "width_px", "height_px", "sha256"],
      "properties": {
        "filename": { "const": "key-image.png" },
        "mime_type": { "const": "image/png" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "measurementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "schema_version",
        "measurement_count",
        "tracking_ids",
        "sha256"
      ],
      "properties": {
        "filename": { "const": "measurements.json" },
        "schema_version": { "const": "3.0.0" },
        "measurement_count": { "type": "integer", "minimum": 0 },
        "tracking_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "renderer"],
      "properties": {
        "name": { "const": "DICOM Guide key-image exporter" },
        "version": { "const": "0.1.0" },
        "renderer": { "const": "Cornerstone3D 5.8.2" }
      }
    }
  }
}
