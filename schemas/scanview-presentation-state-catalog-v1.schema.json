{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanview.local/schemas/scanview-presentation-state-catalog-v1.schema.json",
  "title": "ScanView source-bound DICOM presentation-state catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_at",
    "catalog_content_sha256",
    "local_only",
    "privacy",
    "state_count",
    "supported_state_count",
    "unsupported_state_count",
    "states",
    "unsupported_states",
    "permissions",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "scanview.presentation-state-catalog" },
    "generated_at": { "type": "string", "format": "date-time" },
    "catalog_content_sha256": { "$ref": "#/$defs/sha256" },
    "local_only": { "const": true },
    "privacy": { "$ref": "#/$defs/privacy" },
    "state_count": { "type": "integer", "minimum": 0 },
    "supported_state_count": { "type": "integer", "minimum": 0 },
    "unsupported_state_count": { "type": "integer", "minimum": 0 },
    "states": {
      "type": "array",
      "items": { "$ref": "#/$defs/state" }
    },
    "unsupported_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/unsupportedState" }
    },
    "permissions": { "$ref": "#/$defs/permissions" },
    "limitations": {
      "const": [
        "These are read-only display instructions extracted from source-carried DICOM Grayscale Softcopy Presentation State objects.",
        "ScanView preserves supported source text and geometry but does not authenticate the creator or assess text for identifiers or clinical meaning.",
        "Only a conservative subset is displayed: hashed single-frame monochrome sources whose linear modality transform matches the GSPS, LINEAR VOI, identity presentation LUT, matching source/display aspect, unrotated and unflipped full-image SCALE TO FIT, and PIXEL POLYLINE/anchor-text annotations.",
        "Unsupported presentation-state features fail closed and native DICOM images remain authoritative."
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "studyId": {
      "type": "string",
      "pattern": "^study_[0-9a-f]{20}$"
    },
    "seriesId": {
      "type": "string",
      "pattern": "^series_[0-9a-f]{20}$"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^instance_[0-9a-f]{20}$"
    },
    "patientId": {
      "type": "string",
      "pattern": "^patient_[0-9a-f]{20}$"
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "direct_identifier_tags_excluded",
        "annotation_text_may_contain_identifiers",
        "deidentified",
        "contains_pixels",
        "contains_paths",
        "contains_annotation_text"
      ],
      "properties": {
        "classification": { "const": "sensitive_local_medical_data" },
        "direct_identifier_tags_excluded": { "const": true },
        "annotation_text_may_contain_identifiers": { "const": true },
        "deidentified": { "const": false },
        "contains_pixels": { "const": false },
        "contains_paths": { "const": false },
        "contains_annotation_text": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "series_id",
        "instance_id",
        "patient_context_id",
        "bytes",
        "sha256"
      ],
      "properties": {
        "study_id": { "$ref": "#/$defs/studyId" },
        "series_id": { "$ref": "#/$defs/seriesId" },
        "instance_id": { "$ref": "#/$defs/instanceId" },
        "patient_context_id": { "$ref": "#/$defs/patientId" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "referencedSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "series_id",
        "patient_context_id",
        "modality",
        "instance_ids"
      ],
      "properties": {
        "study_id": { "$ref": "#/$defs/studyId" },
        "series_id": { "$ref": "#/$defs/seriesId" },
        "patient_context_id": { "$ref": "#/$defs/patientId" },
        "modality": { "enum": ["MR", "CT"] },
        "instance_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instanceId" }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rotation_degrees",
        "horizontal_flip",
        "modality_transform",
        "voi_lut_function",
        "presentation_lut_shape",
        "source_pixel_aspect_ratio_verified",
        "window_center",
        "window_width",
        "voi_range",
        "displayed_area",
        "annotation_style"
      ],
      "properties": {
        "rotation_degrees": { "const": 0 },
        "horizontal_flip": { "const": false },
        "modality_transform": { "const": "SOURCE_EQUIVALENT_LINEAR" },
        "voi_lut_function": { "const": "LINEAR" },
        "presentation_lut_shape": { "const": "IDENTITY" },
        "source_pixel_aspect_ratio_verified": { "const": true },
        "window_center": { "type": "number" },
        "window_width": { "type": "number", "minimum": 1 },
        "voi_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "upper"],
          "properties": {
            "lower": { "type": "number" },
            "upper": { "type": "number" }
          }
        },
        "displayed_area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top_left", "bottom_right", "presentation_size_mode"],
          "properties": {
            "top_left": { "$ref": "#/$defs/point" },
            "bottom_right": { "$ref": "#/$defs/point" },
            "presentation_size_mode": { "const": "SCALE TO FIT" }
          }
        },
        "annotation_style": { "const": "scanview_high_contrast_source_geometry" }
      }
    },
    "graphic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphic_id", "type", "units", "filled", "points"],
      "properties": {
        "graphic_id": { "type": "string", "pattern": "^graphic_[0-9]{2}$" },
        "type": { "const": "POLYLINE" },
        "units": { "const": "PIXEL" },
        "filled": { "const": false },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_id",
        "units",
        "anchor_point",
        "anchor_point_visible",
        "unformatted_text"
      ],
      "properties": {
        "text_id": { "type": "string", "pattern": "^text_[0-9]{2}$" },
        "units": { "const": "PIXEL" },
        "anchor_point": { "$ref": "#/$defs/point" },
        "anchor_point_visible": { "type": "boolean" },
        "unformatted_text": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "graphic_layer",
        "referenced_instance_ids",
        "graphics",
        "texts"
      ],
      "properties": {
        "annotation_id": { "type": "string", "pattern": "^annotation_[0-9]{3}$" },
        "graphic_layer": { "type": "string", "minLength": 1, "maxLength": 64 },
        "referenced_instance_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instanceId" }
        },
        "graphics": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/graphic" }
        },
        "texts": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/text" }
        }
      },
      "anyOf": [
        { "properties": { "graphics": { "minItems": 1 } } },
        { "properties": { "texts": { "minItems": 1 } } }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentation_state_id",
        "source",
        "display_status",
        "referenced_series",
        "referenced_instance_count",
        "presentation",
        "annotations",
        "annotation_count",
        "graphic_count",
        "text_count",
        "author_identity_authenticated",
        "scanview_interpretation_added",
        "source_text_clinical_meaning"
      ],
      "properties": {
        "presentation_state_id": { "$ref": "#/$defs/instanceId" },
        "source": { "$ref": "#/$defs/source" },
        "display_status": { "const": "supported_read_only" },
        "referenced_series": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/referencedSeries" }
        },
        "referenced_instance_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "presentation": { "$ref": "#/$defs/presentation" },
        "annotations": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "#/$defs/annotation" }
        },
        "annotation_count": { "type": "integer", "minimum": 0, "maximum": 512 },
        "graphic_count": { "type": "integer", "minimum": 0 },
        "text_count": { "type": "integer", "minimum": 0 },
        "author_identity_authenticated": { "const": false },
        "scanview_interpretation_added": { "const": false },
        "source_text_clinical_meaning": { "const": "not_assessed" }
      }
    },
    "unsupportedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation_state_id", "display_status", "reason"],
      "properties": {
        "presentation_state_id": { "$ref": "#/$defs/instanceId" },
        "display_status": { "const": "unsupported" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_source_navigation_authorized",
        "apply_saved_voi_authorized",
        "display_source_annotations_authorized",
        "edit_source_annotations_authorized",
        "interpret_annotation_text_as_measurement_authorized",
        "author_identity_authenticated",
        "diagnosis_authorized",
        "response_classification_authorized",
        "clinical_conclusion_authorized"
      ],
      "properties": {
        "exact_source_navigation_authorized": { "const": true },
        "apply_saved_voi_authorized": { "const": true },
        "display_source_annotations_authorized": { "const": true },
        "edit_source_annotations_authorized": { "const": false },
        "interpret_annotation_text_as_measurement_authorized": { "const": false },
        "author_identity_authenticated": { "const": false },
        "diagnosis_authorized": { "const": false },
        "response_classification_authorized": { "const": false },
        "clinical_conclusion_authorized": { "const": false }
      }
    }
  }
}
